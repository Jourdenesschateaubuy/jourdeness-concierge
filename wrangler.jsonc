{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jourdeness-concierge",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "JOURDENESS_MEDIA",
      "bucket_name": "jourdeness-media",
      "remote": true
    }
  ]
}
